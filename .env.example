# ==========================================
# CONFIGURACIÓN GENERAL Y PUERTOS
# ==========================================
FRONTEND_PORT=5173
BACKEND_PORT=4000
POSTGRES_PORT=5432
NODE_RED_PORT=1880
KEYCLOAK_PORT=8081

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clima_app
DATABASE_SSL=false
JWT_SECRET=change-this-secret

# ==========================================
# KEYCLOAK ADMINISTRACIÓN
# ==========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ==========================================
# URLS DE ACCESO (AZURE VM / LOCALHOST)
# En Azure VM: reemplaza localhost por la IP pública de tu máquina virtual.
# Ejemplo: si tu IP pública es 20.120.45.67:
# KC_URL=http://20.120.45.67:8081
# FRONTEND_URL=http://20.120.45.67:5173
# VITE_KC_URL=http://20.120.45.67:8081
# VITE_API_URL=http://20.120.45.67:4000/api
# ==========================================
KC_URL=http://localhost:8081
KC_INTERNAL_URL=http://keycloak:8080
KC_REALM=jarvis
KC_CLIENT_ID=jarvis-web
FRONTEND_URL=http://localhost:5173

# Frontend (Vite)
VITE_KC_URL=http://localhost:8081
VITE_KC_REALM=jarvis
VITE_KC_CLIENT_ID=jarvis-web
VITE_API_URL=http://localhost:4000/api

# ==========================================
# IOT & DISPOSITIVOS ESP32
# ==========================================
IOT_DEVICE_CLAIM_CODE=change-device-claim-code
IOT_DEVICE_INGEST_KEY=change-iot-ingest-key

# ==========================================
# SERVICIOS OPCIONALES
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENWEATHER_API_KEY=
